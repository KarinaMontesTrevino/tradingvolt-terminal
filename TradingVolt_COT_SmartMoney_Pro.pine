//@version=5
indicator(title="TradingVolt • COT Smart Money & Commodities Terminal [Auto-Update]", shorttitle="TV • COT Smart Money", overlay=false, precision=1, max_labels_count=100)

// ============================================================================
// 1. IMPORTACION OFICIAL DE DATOS CFTC DE TRADINGVIEW (AUTO-UPDATE SEMANAL)
// ============================================================================
import TradingView/LibraryCOT/2 as cot

// ============================================================================
// 2. CONFIGURACION DEL USUARIO
// ============================================================================
grp_mode = "1. Modo Visual & Mercado CFTC"
MODE_HIST = "Histograma Institucional (Neto en Miles de Contratos)"
MODE_OSC  = "Oscilador COT Index 0-100% (Detectar Techos y Suelos)"

visual_mode = input.string(defval=MODE_HIST, title="Modo de Visualizacion", options=[MODE_HIST, MODE_OSC], group=grp_mode)

MKT_AUTO = "Auto-Detectar (Futuros, Spot, CFDs y ETFs)"
market_override = input.string(defval=MKT_AUTO, title="Mercado CFTC a Graficar", options=[MKT_AUTO, "GC - Oro (Gold COMEX)", "SI - Plata (Silver COMEX)", "HG - Cobre (Copper COMEX)", "PL - Platino (Platinum NYMEX)", "PA - Paladio (Palladium NYMEX)", "CL - Petroleo WTI (Crude Oil NYMEX)", "NG - Gas Natural (Henry Hub NYMEX)", "RB - Gasolina RBOB (NYMEX)", "HO - Heating Oil / Diesel ULSD (NYMEX)", "ZC - Maiz (Corn CBOT)", "ZS - Frijol de Soya (Soybeans CBOT)", "ZW - Trigo Chicago SRW (Wheat CBOT)", "KE - Trigo Kansas HRW (KC Wheat CBOT)", "ZM - Harina de Soya (Soybean Meal CBOT)", "ZL - Aceite de Soya (Soybean Oil CBOT)", "ZO - Avena (Oats CBOT)", "ZR - Arroz (Rough Rice CBOT)", "KC - Cafe Arabica (Coffee ICE)", "CC - Cacao (Cocoa ICE)", "SB - Azucar No. 11 (Sugar ICE)", "CT - Algodon No. 2 (Cotton ICE)", "OJ - Jugo de Naranja FCOJ (ICE)", "LBS - Madera Fisica (Lumber CME)", "LE - Ganado en Pie (Live Cattle CME)", "GF - Ganado de Engorde (Feeder Cattle CME)", "HE - Porcino Magro (Lean Hogs CME)", "DC - Leche Clase III (Milk CME)", "ES - S&P 500 E-mini (CME)", "NQ - Nasdaq 100 E-mini (CME)", "YM - Dow Jones E-mini (CBOT)", "RTY - Russell 2000 E-mini (CME)", "VX - VIX Volatility Futures (CFE)", "US - Bono Tesoro 30 Anos (30Y Bond CBOT)", "ZN - Nota Tesoro 10 Anos (10Y Note CBOT)", "ZF - Nota Tesoro 5 Anos (5Y Note CBOT)", "DX - Indice Dolar (DXY ICE)", "6E - Euro FX (EURUSD CME)", "6J - Yen Japones (JPY CME)", "6B - Libra Esterlina (GBP CME)", "6A - Dolar Australiano (AUD CME)", "6C - Dolar Canadiense (CAD CME)", "BTC - Bitcoin Futures (CME)"], group=grp_mode)

include_opts = input.bool(false, "Incluir Opciones junto con Futuros (Futures + Options)", group=grp_mode)

grp_calc = "2. Parametros del COT Index & Senales"
cot_lookback_weeks = input.int(156, "Periodo Percentil COT Index (Semanas: 156 = 3 Anos, 52 = 1 Ano)", minval=13, maxval=260, group=grp_calc)
upper_extreme      = input.int(80,  "Umbral Extremo Superior (Compras Record / Hacinamiento %)", minval=65, maxval=95, group=grp_calc)
lower_extreme      = input.int(20,  "Umbral Extremo Inferior (Ventas Record / Capitulacion %)", minval=5,  maxval=35, group=grp_calc)

grp_vis = "3. Elementos Visuales y Panel HUD"
show_comm    = input.bool(true, "Mostrar Commercials (Productores / Smart Money Hedgers - Rojo)", group=grp_vis)
show_noncomm = input.bool(true, "Mostrar Non-Commercials (Hedge Funds / Especuladores - Azul)", group=grp_vis)
show_small   = input.bool(true, "Mostrar Small Traders (Retail / No Reportables - Naranja)", group=grp_vis)
show_signals = input.bool(true, "Pintar Senales de Extremos (Squeeze Alcista / Techo Especulativo)", group=grp_vis)
show_table   = input.bool(true, "Mostrar Panel Institucional HUD (Resumen Semanal CFTC)", group=grp_vis)

// ============================================================================
// 3. RESOLUCION DE CODIGO CFTC COMO 'SIMPLE STRING' PURO (SIN FUNCIONES SERIES)
// ============================================================================
simple string r = syminfo.root
simple string t = syminfo.ticker

simple string auto_code = (r == "GC" or r == "MGC" or t == "XAUUSD" or t == "GLD" or t == "IAU" or t == "GOLD") ? "088691" : (r == "SI" or r == "SIL" or t == "XAGUSD" or t == "SLV" or t == "SILVER") ? "084691" : (r == "HG" or t == "COPPER" or t == "CPER" or t == "XCUUSD") ? "085692" : (r == "PL" or t == "XPTUSD" or t == "PPLT") ? "076651" : (r == "PA" or t == "XPDUSD" or t == "PALL") ? "075651" : (r == "CL" or r == "MCL" or t == "USOIL" or t == "WTI" or t == "USO") ? "067651" : (r == "NG" or t == "NATGAS" or t == "UNG") ? "023651" : (r == "RB" or t == "UGA") ? "111659" : (r == "HO") ? "022651" : (r == "ZC" or r == "C" or t == "CORN") ? "002602" : (r == "ZS" or r == "S" or t == "SOYB") ? "005602" : (r == "ZW" or r == "W" or t == "WEAT") ? "001602" : (r == "KE" or r == "KW") ? "001612" : (r == "ZM" or r == "SM") ? "026603" : (r == "ZL" or r == "BO") ? "007601" : (r == "ZO" or r == "O") ? "004603" : (r == "ZR" or r == "RR") ? "039601" : (r == "KC" or t == "JO" or t == "COFFEE") ? "083731" : (r == "CC" or t == "NIB" or t == "COCOA") ? "073732" : (r == "SB" or t == "CANE" or t == "SUGAR") ? "080732" : (r == "CT" or t == "BAL" or t == "COTTON") ? "033661" : (r == "OJ") ? "040701" : (r == "LBS" or r == "LBR") ? "058644" : (r == "LE") ? "057642" : (r == "GF") ? "061641" : (r == "HE") ? "054642" : (r == "DC") ? "052641" : (r == "ES" or r == "MES" or t == "SPY" or t == "SPX" or t == "US500" or t == "SPX500") ? "13874A" : (r == "NQ" or r == "MNQ" or t == "QQQ" or t == "NDX" or t == "NAS100" or t == "US100") ? "209742" : (r == "YM" or r == "MYM" or t == "DIA" or t == "DJI" or t == "US30") ? "124603" : (r == "RTY" or r == "M2K" or t == "IWM" or t == "RUT" or t == "US2000") ? "239742" : (r == "VX" or t == "VIX" or t == "UVXY" or t == "VXX") ? "1170E1" : (r == "ZB" or r == "US" or t == "TLT") ? "020601" : (r == "ZN" or t == "IEF") ? "043602" : (r == "ZF" or t == "IEI") ? "044601" : (r == "DX" or t == "DXY" or t == "UUP") ? "098662" : (r == "6E" or t == "EURUSD" or t == "FXE") ? "099741" : (r == "6J" or t == "USDJPY" or t == "JPYUSD" or t == "FXY") ? "097741" : (r == "6B" or t == "GBPUSD" or t == "FXB") ? "096742" : (r == "6A" or t == "AUDUSD" or t == "FXA") ? "232741" : (r == "6C" or t == "USDCAD" or t == "CADUSD" or t == "FXC") ? "090741" : (r == "BTC" or t == "BTCUSD" or t == "BTCUSDT" or t == "IBIT" or t == "FBTC") ? "133741" : cot.convertRootToCOTCode("Auto")

simple string manual_code = market_override == "GC - Oro (Gold COMEX)" ? "088691" : market_override == "SI - Plata (Silver COMEX)" ? "084691" : market_override == "HG - Cobre (Copper COMEX)" ? "085692" : market_override == "PL - Platino (Platinum NYMEX)" ? "076651" : market_override == "PA - Paladio (Palladium NYMEX)" ? "075651" : market_override == "CL - Petroleo WTI (Crude Oil NYMEX)" ? "067651" : market_override == "NG - Gas Natural (Henry Hub NYMEX)" ? "023651" : market_override == "RB - Gasolina RBOB (NYMEX)" ? "111659" : market_override == "HO - Heating Oil / Diesel ULSD (NYMEX)" ? "022651" : market_override == "ZC - Maiz (Corn CBOT)" ? "002602" : market_override == "ZS - Frijol de Soya (Soybeans CBOT)" ? "005602" : market_override == "ZW - Trigo Chicago SRW (Wheat CBOT)" ? "001602" : market_override == "KE - Trigo Kansas HRW (KC Wheat CBOT)" ? "001612" : market_override == "ZM - Harina de Soya (Soybean Meal CBOT)" ? "026603" : market_override == "ZL - Aceite de Soya (Soybean Oil CBOT)" ? "007601" : market_override == "ZO - Avena (Oats CBOT)" ? "004603" : market_override == "ZR - Arroz (Rough Rice CBOT)" ? "039601" : market_override == "KC - Cafe Arabica (Coffee ICE)" ? "083731" : market_override == "CC - Cacao (Cocoa ICE)" ? "073732" : market_override == "SB - Azucar No. 11 (Sugar ICE)" ? "080732" : market_override == "CT - Algodon No. 2 (Cotton ICE)" ? "033661" : market_override == "OJ - Jugo de Naranja FCOJ (ICE)" ? "040701" : market_override == "LBS - Madera Fisica (Lumber CME)" ? "058644" : market_override == "LE - Ganado en Pie (Live Cattle CME)" ? "057642" : market_override == "GF - Ganado de Engorde (Feeder Cattle CME)" ? "061641" : market_override == "HE - Porcino Magro (Lean Hogs CME)" ? "054642" : market_override == "DC - Leche Clase III (Milk CME)" ? "052641" : market_override == "ES - S&P 500 E-mini (CME)" ? "13874A" : market_override == "NQ - Nasdaq 100 E-mini (CME)" ? "209742" : market_override == "YM - Dow Jones E-mini (CBOT)" ? "124603" : market_override == "RTY - Russell 2000 E-mini (CME)" ? "239742" : market_override == "VX - VIX Volatility Futures (CFE)" ? "1170E1" : market_override == "US - Bono Tesoro 30 Anos (30Y Bond CBOT)" ? "020601" : market_override == "ZN - Nota Tesoro 10 Anos (10Y Note CBOT)" ? "043602" : market_override == "ZF - Nota Tesoro 5 Anos (5Y Note CBOT)" ? "044601" : market_override == "DX - Indice Dolar (DXY ICE)" ? "098662" : market_override == "6E - Euro FX (EURUSD CME)" ? "099741" : market_override == "6J - Yen Japones (JPY CME)" ? "097741" : market_override == "6B - Libra Esterlina (GBP CME)" ? "096742" : market_override == "6A - Dolar Australiano (AUD CME)" ? "232741" : market_override == "6C - Dolar Canadiense (CAD CME)" ? "090741" : market_override == "BTC - Bitcoin Futures (CME)" ? "133741" : auto_code

simple string cftc_code = market_override == MKT_AUTO ? auto_code : manual_code

simple string market_title = cftc_code == "088691" ? "GC • Gold (Oro COMEX)" : cftc_code == "084691" ? "SI • Silver (Plata COMEX)" : cftc_code == "085692" ? "HG • Copper (Cobre COMEX)" : cftc_code == "076651" ? "PL • Platinum (Platino NYMEX)" : cftc_code == "075651" ? "PA • Palladium (Paladio NYMEX)" : cftc_code == "067651" ? "CL • WTI Crude Oil (NYMEX)" : cftc_code == "023651" ? "NG • Natural Gas (NYMEX)" : cftc_code == "111659" ? "RB • RBOB Gasoline (NYMEX)" : cftc_code == "022651" ? "HO • Heating Oil ULSD (NYMEX)" : cftc_code == "002602" ? "ZC • Corn (Maiz CBOT)" : cftc_code == "005602" ? "ZS • Soybeans (Soya CBOT)" : cftc_code == "001602" ? "ZW • Chicago SRW Wheat (CBOT)" : cftc_code == "001612" ? "KE • Kansas HRW Wheat (CBOT)" : cftc_code == "026603" ? "ZM • Soybean Meal (CBOT)" : cftc_code == "007601" ? "ZL • Soybean Oil (CBOT)" : cftc_code == "004603" ? "ZO • Oats (Avena CBOT)" : cftc_code == "039601" ? "ZR • Rough Rice (Arroz CBOT)" : cftc_code == "083731" ? "KC • Coffee Arabica (ICE)" : cftc_code == "073732" ? "CC • Cocoa (Cacao ICE)" : cftc_code == "080732" ? "SB • Sugar No. 11 (ICE)" : cftc_code == "033661" ? "CT • Cotton No. 2 (ICE)" : cftc_code == "040701" ? "OJ • Orange Juice FCOJ (ICE)" : cftc_code == "058644" ? "LBS • Lumber (Madera CME)" : cftc_code == "057642" ? "LE • Live Cattle (Ganado CME)" : cftc_code == "061641" ? "GF • Feeder Cattle (CME)" : cftc_code == "054642" ? "HE • Lean Hogs (Porcino CME)" : cftc_code == "052641" ? "DC • Class III Milk (CME)" : cftc_code == "13874A" ? "ES • S&P 500 E-mini (CME)" : cftc_code == "209742" ? "NQ • Nasdaq 100 E-mini (CME)" : cftc_code == "124603" ? "YM • Dow Jones E-mini (CBOT)" : cftc_code == "239742" ? "RTY • Russell 2000 E-mini (CME)" : cftc_code == "1170E1" ? "VX • VIX Futures (CFE)" : cftc_code == "020601" ? "ZB • 30Y Treasury Bond (CBOT)" : cftc_code == "043602" ? "ZN • 10Y Treasury Note (CBOT)" : cftc_code == "044601" ? "ZF • 5Y Treasury Note (CBOT)" : cftc_code == "098662" ? "DX • Dollar Index (ICE)" : cftc_code == "099741" ? "6E • Euro FX (CME)" : cftc_code == "097741" ? "6J • Japanese Yen (CME)" : cftc_code == "096742" ? "6B • British Pound (CME)" : cftc_code == "232741" ? "6A • Australian Dollar (CME)" : cftc_code == "090741" ? "6C • Canadian Dollar (CME)" : cftc_code == "133741" ? "BTC • CME Bitcoin Futures" : (r + " • CFTC (" + cftc_code + ")")

// ============================================================================
// 4. DESCARGA AUTOMATICA SEMANAL DESDE LA BASE DE DATOS CFTC DE TRADINGVIEW
// ============================================================================
simple string id_comm_long     = cot.COTTickerid("Legacy", cftc_code, include_opts, "Commercial Positions", "Long", "All")
simple string id_comm_short    = cot.COTTickerid("Legacy", cftc_code, include_opts, "Commercial Positions", "Short", "All")
simple string id_noncomm_long  = cot.COTTickerid("Legacy", cftc_code, include_opts, "Noncommercial Positions", "Long", "All")
simple string id_noncomm_short = cot.COTTickerid("Legacy", cftc_code, include_opts, "Noncommercial Positions", "Short", "All")
simple string id_small_long    = cot.COTTickerid("Legacy", cftc_code, include_opts, "Nonreportable Positions", "Long", "All")
simple string id_small_short   = cot.COTTickerid("Legacy", cftc_code, include_opts, "Nonreportable Positions", "Short", "All")
simple string id_oi            = cot.COTTickerid("Legacy", cftc_code, include_opts, "Open Interest", "No direction", "All")

comm_long     = request.security(id_comm_long, "1W", close, ignore_invalid_symbol=true)
comm_short    = request.security(id_comm_short, "1W", close, ignore_invalid_symbol=true)
noncomm_long  = request.security(id_noncomm_long, "1W", close, ignore_invalid_symbol=true)
noncomm_short = request.security(id_noncomm_short, "1W", close, ignore_invalid_symbol=true)
small_long    = request.security(id_small_long, "1W", close, ignore_invalid_symbol=true)
small_short   = request.security(id_small_short, "1W", close, ignore_invalid_symbol=true)
open_interest = request.security(id_oi, "1W", close, ignore_invalid_symbol=true)

comm_net      = comm_long - comm_short
noncomm_net   = noncomm_long - noncomm_short
small_net     = small_long - small_short

comm_net_k    = comm_net / 1000.0
noncomm_net_k = noncomm_net / 1000.0
small_net_k   = small_net / 1000.0
oi_k          = open_interest / 1000.0

bool new_cot_week = ta.change(comm_net) != 0 or ta.change(noncomm_net) != 0 or ta.change(open_interest) != 0
var float prev_comm_k    = na
var float prev_noncomm_k = na
var float prev_small_k   = na
var float prev_oi_k      = na

if new_cot_week
    prev_comm_k    := comm_net_k[1]
    prev_noncomm_k := noncomm_net_k[1]
    prev_small_k   := small_net_k[1]
    prev_oi_k      := oi_k[1]

comm_wow_k    = comm_net_k - nz(prev_comm_k, comm_net_k)
noncomm_wow_k = noncomm_net_k - nz(prev_noncomm_k, noncomm_net_k)
small_wow_k   = small_net_k - nz(prev_small_k, small_net_k)
oi_wow_k      = oi_k - nz(prev_oi_k, oi_k)

comm_pct_oi    = open_interest > 0 ? (comm_net / open_interest) * 100.0 : 0.0
noncomm_pct_oi = open_interest > 0 ? (noncomm_net / open_interest) * 100.0 : 0.0
small_pct_oi   = open_interest > 0 ? (small_net / open_interest) * 100.0 : 0.0

// ============================================================================
// 5. CALCULO DEL COT INDEX (0 - 100%) EN VENTANA DE N SEMANAS
// ============================================================================
int bars_per_week = timeframe.isweekly ? 1 : timeframe.isdaily ? 5 : timeframe.isintraday ? math.max(1, int(math.round(5.0 * 390.0 / math.max(1.0, float(timeframe.multiplier))))) : 1
int lookback_bars = math.max(1, math.min(2000, cot_lookback_weeks * bars_per_week))

comm_low  = ta.lowest(comm_net, lookback_bars)
comm_high = ta.highest(comm_net, lookback_bars)
comm_idx  = nz(comm_high > comm_low ? ((comm_net - comm_low) / (comm_high - comm_low)) * 100.0 : 50.0, 50.0)

spec_low  = ta.lowest(noncomm_net, lookback_bars)
spec_high = ta.highest(noncomm_net, lookback_bars)
spec_idx  = nz(spec_high > spec_low ? ((noncomm_net - spec_low) / (spec_high - spec_low)) * 100.0 : 50.0, 50.0)

// ============================================================================
// 6. DIAGNOSTICO AUTOMATICO Y SENALES DE GIRO INSTITUCIONAL
// ============================================================================
bool is_smart_money_bullish = comm_idx >= upper_extreme and spec_idx <= lower_extreme
bool is_spec_crowded_top    = spec_idx >= upper_extreme and comm_idx <= lower_extreme

string regime_text  = "NEUTRAL / RANGO INSTITUCIONAL"
color  regime_color = color.new(#EAB308, 0)

if is_smart_money_bullish
    regime_text  := "ACUMULACION SMART MONEY / SHORT SQUEEZE SETUP"
    regime_color := color.new(#10B981, 0)
else if is_spec_crowded_top
    regime_text  := "FONDOS HACINADOS EN LARGO / RIESGO DE TECHO"
    regime_color := color.new(#EF4444, 0)
else if comm_idx >= 65
    regime_text  := "SESGO COMERCIAL CONSTRUCTIVO (SMART MONEY COMPRANDO)"
    regime_color := color.new(#34D399, 0)
else if spec_idx >= 65
    regime_text  := "MOMENTUM ESPECULATIVO ALCISTA (MANAGED MONEY LONG)"
    regime_color := color.new(#38BDF8, 0)
else if spec_idx <= 30
    regime_text  := "PRESION BAJISTA ESPECULATIVA (MANAGED MONEY SHORT)"
    regime_color := color.new(#F97316, 0)

// ============================================================================
// 7. RENDERIZADO GRAFICO (MODO HISTOGRAMA NETO VS MODO OSCILADOR 0-100%)
// ============================================================================
bool is_hist_mode = visual_mode == MODE_HIST

col_noncomm = #3378FF
col_comm    = #E53935
col_small   = #FFA726

// --- MODO 1: HISTOGRAMA INSTITUCIONAL (MILES DE CONTRATOS) ---
plot(is_hist_mode and show_noncomm ? noncomm_net_k : na, title="Non-Commercial Net (Hedge Funds - K)", color=color.new(col_noncomm, 15), style=plot.style_columns, linewidth=3)
plot(is_hist_mode and show_comm ? comm_net_k : na, title="Commercial Net (Smart Money Hedgers - K)", color=color.new(col_comm, 15), style=plot.style_columns, linewidth=3)
plot(is_hist_mode and show_small ? small_net_k : na, title="Small Traders Net (Retail - K)", color=color.new(col_small, 10), style=plot.style_line, linewidth=2)

// --- MODO 2: OSCILADOR COT INDEX (0 - 100%) ---
plot(not is_hist_mode and show_comm ? comm_idx : na, title="Commercial COT Index (0-100%)", color=col_comm, linewidth=3)
plot(not is_hist_mode and show_noncomm ? spec_idx : na, title="Large Speculator COT Index (0-100%)", color=col_noncomm, linewidth=2)

plot(not is_hist_mode ? upper_extreme : na, title="Extremo Superior (%)", color=color.new(#EF4444, 55), style=plot.style_linebr)
plot(not is_hist_mode ? 50 : na, title="Nivel Neutral (50%)", color=color.new(#64748B, 65), style=plot.style_linebr)
plot(not is_hist_mode ? lower_extreme : na, title="Extremo Inferior (%)", color=color.new(#10B981, 55), style=plot.style_linebr)

hline(0, "Linea Cero / Equilibrio", color=color.new(#475569, 40), linestyle=hline.style_solid, linewidth=1)

bg_col = show_signals and is_smart_money_bullish ? color.new(#10B981, 86) : show_signals and is_spec_crowded_top ? color.new(#EF4444, 86) : na
bgcolor(bg_col, title="Fondo de Zona Extrema COT")

bool trigger_bull = is_smart_money_bullish and not is_smart_money_bullish[1]
bool trigger_bear = is_spec_crowded_top and not is_spec_crowded_top[1]

plotshape(show_signals and trigger_bull, title="Senal Acumulacion Comercial Extrema (Alcista)", style=shape.labelup, location=location.bottom, color=color.new(#10B981, 0), textcolor=color.white, text="SMART MONEY LONG", size=size.tiny)
plotshape(show_signals and trigger_bear, title="Senal Especuladores Saturados (Riesgo Techo)", style=shape.labeldown, location=location.top, color=color.new(#EF4444, 0), textcolor=color.white, text="SPEC CROWDED", size=size.tiny)

// ============================================================================
// 8. PANEL HUD INSTITUCIONAL EN TIEMPO REAL (TABLA AUTO-ACTUALIZABLE)
// ============================================================================
f_fmt_signed_k(float val) =>
    (val >= 0 ? "+" : "") + str.tostring(val, "#,##0.1") + "K"

f_fmt_pct(float val) =>
    (val >= 0 ? "+" : "") + str.tostring(val, "0.0") + "%"

var table cot_hud = table.new(position.top_right, 5, 6, bgcolor=color.new(#0B0F19, 8), border_color=color.new(#1E293B, 0), border_width=1, frame_color=color.new(#334155, 0), frame_width=1)

if barstate.islast and show_table
    table.cell(cot_hud, 0, 0, "CFTC COT • " + market_title, text_color=color.white, bgcolor=color.new(#0F172A, 0), text_size=size.small, text_halign=text.align_left)
    table.cell(cot_hud, 1, 0, "Posicion Neta", text_color=#94A3B8, bgcolor=color.new(#0F172A, 0), text_size=size.small)
    table.cell(cot_hud, 2, 0, "Cambio WoW", text_color=#94A3B8, bgcolor=color.new(#0F172A, 0), text_size=size.small)
    table.cell(cot_hud, 3, 0, "% Open Int", text_color=#94A3B8, bgcolor=color.new(#0F172A, 0), text_size=size.small)
    table.cell(cot_hud, 4, 0, "COT Index 3Y", text_color=#94A3B8, bgcolor=color.new(#0F172A, 0), text_size=size.small)

    color comm_idx_col = comm_idx >= upper_extreme ? #10B981 : comm_idx <= lower_extreme ? #EF4444 : #E2E8F0
    table.cell(cot_hud, 0, 1, "Commercial (Smart Money Hedgers)", text_color=#F8FAFC, bgcolor=color.new(#1E293B, 35), text_size=size.small, text_halign=text.align_left)
    table.cell(cot_hud, 1, 1, f_fmt_signed_k(comm_net_k), text_color=comm_net_k >= 0 ? #10B981 : #F87171, bgcolor=color.new(#1E293B, 35), text_size=size.small)
    table.cell(cot_hud, 2, 1, f_fmt_signed_k(comm_wow_k), text_color=comm_wow_k >= 0 ? #34D399 : #FB7185, bgcolor=color.new(#1E293B, 35), text_size=size.small)
    table.cell(cot_hud, 3, 1, f_fmt_pct(comm_pct_oi), text_color=#CBD5E1, bgcolor=color.new(#1E293B, 35), text_size=size.small)
    table.cell(cot_hud, 4, 1, str.tostring(comm_idx, "0") + "%", text_color=comm_idx_col, bgcolor=color.new(#1E293B, 35), text_size=size.small)

    color spec_idx_col = spec_idx >= upper_extreme ? #EF4444 : spec_idx <= lower_extreme ? #10B981 : #38BDF8
    table.cell(cot_hud, 0, 2, "Non-Commercial (Hedge Funds)", text_color=#F8FAFC, bgcolor=color.new(#0F172A, 20), text_size=size.small, text_halign=text.align_left)
    table.cell(cot_hud, 1, 2, f_fmt_signed_k(noncomm_net_k), text_color=noncomm_net_k >= 0 ? #38BDF8 : #F87171, bgcolor=color.new(#0F172A, 20), text_size=size.small)
    table.cell(cot_hud, 2, 2, f_fmt_signed_k(noncomm_wow_k), text_color=noncomm_wow_k >= 0 ? #34D399 : #FB7185, bgcolor=color.new(#0F172A, 20), text_size=size.small)
    table.cell(cot_hud, 3, 2, f_fmt_pct(noncomm_pct_oi), text_color=#CBD5E1, bgcolor=color.new(#0F172A, 20), text_size=size.small)
    table.cell(cot_hud, 4, 2, str.tostring(spec_idx, "0") + "%", text_color=spec_idx_col, bgcolor=color.new(#0F172A, 20), text_size=size.small)

    table.cell(cot_hud, 0, 3, "Small Traders (Retail)", text_color=#F8FAFC, bgcolor=color.new(#1E293B, 35), text_size=size.small, text_halign=text.align_left)
    table.cell(cot_hud, 1, 3, f_fmt_signed_k(small_net_k), text_color=#FFA726, bgcolor=color.new(#1E293B, 35), text_size=size.small)
    table.cell(cot_hud, 2, 3, f_fmt_signed_k(small_wow_k), text_color=small_wow_k >= 0 ? #34D399 : #FB7185, bgcolor=color.new(#1E293B, 35), text_size=size.small)
    table.cell(cot_hud, 3, 3, f_fmt_pct(small_pct_oi), text_color=#CBD5E1, bgcolor=color.new(#1E293B, 35), text_size=size.small)
    table.cell(cot_hud, 4, 3, "-", text_color=#64748B, bgcolor=color.new(#1E293B, 35), text_size=size.small)

    table.cell(cot_hud, 0, 4, "Open Interest Total", text_color=#00E676, bgcolor=color.new(#0F172A, 20), text_size=size.small, text_halign=text.align_left)
    table.cell(cot_hud, 1, 4, str.tostring(open_interest, "#,###"), text_color=#00E676, bgcolor=color.new(#0F172A, 20), text_size=size.small)
    table.cell(cot_hud, 2, 4, f_fmt_signed_k(oi_wow_k), text_color=oi_wow_k >= 0 ? #00E676 : #FB7185, bgcolor=color.new(#0F172A, 20), text_size=size.small)
    table.cell(cot_hud, 3, 4, "100.0%", text_color=#64748B, bgcolor=color.new(#0F172A, 20), text_size=size.small)
    table.cell(cot_hud, 4, 4, "CFTC #" + cftc_code, text_color=#94A3B8, bgcolor=color.new(#0F172A, 20), text_size=size.small)

    table.cell(cot_hud, 0, 5, "Diagnostico CFTC:", text_color=#CBD5E1, bgcolor=color.new(#0F172A, 0), text_size=size.small, text_halign=text.align_left)
    table.cell(cot_hud, 1, 5, regime_text, text_color=regime_color, bgcolor=color.new(#0F172A, 0), text_size=size.small)
    table.merge_cells(cot_hud, 1, 5, 4, 5)

// ============================================================================
// 9. ALERTAS AUTOMATICAS SEMANALES
// ============================================================================
alertcondition(trigger_bull, "COT Smart Money Acumulacion Extrema (Alcista)", "CFTC COT Alert: Commercials (Smart Money) en extremo de compras (>80%) y Especuladores en extremo corto (<20%). Potencial Short Squeeze / Suelo Institucional.")
alertcondition(trigger_bear, "COT Especuladores Hacinados en Largo (Riesgo Techo)", "CFTC COT Alert: Hedge Funds saturados en compras (>80%) y Productores Comerciales vendiendo coberturas al maximo (<20%). Riesgo de agotamiento o correccion.")
alertcondition(new_cot_week, "Nuevo Reporte Semanal CFTC Publicado", "Se ha actualizado el nuevo reporte semanal CFTC Commitments of Traders en TradingView.")
