// © TradingVolt Institutional Quant Desk — Daily Pivot Breakout Screener + Pine Screener Ready
//@version=5
indicator(title="TradingVolt • Daily Pivot Breakout SCANNER [by Mike]", shorttitle="TV • Pivot Scanner", overlay=true, max_labels_count=500)

// ============================================================================
// 1. EXACT PARAMETERS (DAILY PIVOT BREAKOUT STRATEGY INDICATOR BY MIKE)
// ============================================================================
left_s = input.int(5, "Left Strength", minval=1)
right_s = input.int(5, "Right Strength", minval=1)
piv_lb = input.int(100, "Pivot Lookback", minval=10)
roc_len = input.int(100, "ROC Period (days)", minval=5)
min_roc = input.float(30.0, "Minimum ROC (%)", minval=0.0)
rvol_len = input.int(20, "RVOL Period (days)", minval=5)
ema_len = input.int(100, "EMA Length", minval=5)
slope_lb = input.int(100, "EMA Slope Lookback", minval=5)
smooth_len = input.int(1, "EMA Smooth Length", minval=1)
min_slope = input.float(20.0, "Min EMA Slope (%)", minval=-50.0)
trail_pct = input.float(20.0, "Trailing Stop (%)", minval=1.0)
enable_mom = input.bool(true, "Enable Momentum Candle Colors")

// ============================================================================
// 2. CORE EVALUATION FUNCTION (FOR CURRENT CHART & PINE SCREENER)
// ============================================================================
roc_val = ((close - close[roc_len]) / nz(close[roc_len], close)) * 100.0
vol_avg = ta.sma(volume[1], rvol_len)
rvol_val = volume / math.max(vol_avg, 1.0)

ema_raw = ta.ema(close, ema_len)
ema_100 = smooth_len > 1 ? ta.ema(ema_raw, smooth_len) : ema_raw
ema_past = nz(ema_100[slope_lb], ema_100)
ema_slope = ((ema_100 - ema_past) / math.max(ema_past, 0.0001)) * 100.0

ph = ta.pivothigh(high, left_s, right_s)
var float active_piv = na
var int active_piv_bar = na
var bool piv_broken = false

if not na(ph)
    active_piv := ph
    active_piv_bar := bar_index - right_s
    piv_broken := false

if not na(active_piv_bar) and (bar_index - active_piv_bar > piv_lb)
    active_piv := na
    active_piv_bar := na
    piv_broken := false

cond_mom = roc_val >= min_roc
cond_slp = (ema_slope >= min_slope) and (close > ema_100)
cond_rvl = rvol_val > 1.0

cross_piv = not na(active_piv) and not piv_broken and (close > active_piv) and (close[1] <= active_piv * 1.005)
breakout_signal = cross_piv and cond_mom and cond_slp and cond_rvl

if not na(active_piv) and close > active_piv
    piv_broken := true

var bool in_trade = false
var float peak_px = na
var float trail_stop = na

if breakout_signal
    in_trade := true
    peak_px := math.max(high, close)
    trail_stop := peak_px * (1.0 - trail_pct / 100.0)
else if in_trade
    peak_px := math.max(nz(peak_px, high), math.max(high, close))
    trail_stop := peak_px * (1.0 - trail_pct / 100.0)

exit_signal = in_trade and not breakout_signal and (close < trail_stop)
if exit_signal
    in_trade := false
    peak_px := na
    trail_stop := na

dist_piv_pct = not na(active_piv) ? ((close - active_piv) / active_piv) * 100.0 : 0.0
near_piv_setup = not na(active_piv) and not piv_broken and (dist_piv_pct >= -3.5 and dist_piv_pct <= 2.0) and cond_mom and cond_slp

// ============================================================================
// 3. PLOTS FOR TRADINGVIEW "PINE SCREENER" (DATA WINDOW / SCREENER EXPORT)
// ============================================================================
plot(breakout_signal ? 1 : 0, "1_Breakout_Signal", display=display.data_window)
plot(near_piv_setup ? 1 : 0, "2_PreBreakout_NearPivot", display=display.data_window)
plot(cond_mom and cond_slp ? 1 : 0, "3_Momentum_And_Slope_OK", display=display.data_window)
plot(roc_val, "4_ROC_100d_Pct", display=display.data_window)
plot(ema_slope, "5_EMA100_Slope_Pct", display=display.data_window)
plot(rvol_val, "6_RVOL_20d", display=display.data_window)
plot(active_piv, "Pivot High (───)", color=color.new(#10B981, 0), linewidth=2, style=plot.style_linebr)
plot(in_trade ? trail_stop : na, "20% Trailing Stop (•••••••)", color=color.new(#38BDF8, 0), linewidth=3, style=plot.style_circles)
plot(ema_100, "EMA 100", color=color.new(#FF9100, 20), linewidth=2)

mom_col = breakout_signal ? color.new(#00FF87, 0) : (cond_mom and cond_slp ? color.new(#00F0FF, 0) : ((roc_val >= min_roc * 0.5 or ema_slope >= min_slope * 0.5) and close > ema_100 ? color.new(#FFD600, 0) : (close > ema_100 ? color.new(#B388FF, 15) : na)))
barcolor(enable_mom ? mom_col : na)

plotshape(breakout_signal, title="Entry Signal (Breakout)", style=shape.triangleup, location=location.belowbar, color=color.new(#00FF87, 0), size=size.small, text="Breakout", textcolor=color.new(#00FF87, 0))
plotshape(exit_signal, title="20% Trailing Stop Exit", style=shape.xcross, location=location.abovebar, color=color.new(#FF2E63, 0), size=size.small, text="Stop 20%", textcolor=color.new(#FF2E63, 0))

alertcondition(breakout_signal, title="🚀 Daily Pivot Breakout Signal", message="{{ticker}} rompió el Pivot High (5L/5R) con ROC(100)>=30%, EMA(100) Slope>=20% y RVOL(20)>1x a ${{close}}")
